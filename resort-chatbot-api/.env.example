# --- เลือก LLM provider หลัก: "typhoon" หรือ "gemini" ---
LLM_PROVIDER=typhoon

# --- Typhoon API (https://opentyphoon.ai) ---
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# --- Gemini API (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embedding model (รันโลคัลผ่าน sentence-transformers ไม่มีค่า API) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Vector store (ChromaDB, embedded, เก็บลง local disk) ---
# CHROMA_PATH — ไม่ต้องตั้ง ปล่อยให้โค้ดคำนวณเอง
# ค่าเริ่มต้นชี้ไป ../indexing-pipeline/chroma_db แบบ absolute path
# ซึ่งเป็น collection ที่ indexing-pipeline สร้างไว้
# ถ้าตั้งเป็น path แบบ relative จะพังเมื่อรัน uvicorn จากโฟลเดอร์อื่น
CHROMA_COLLECTION_NAME=resort_knowledge

# --- Booking API (NestJS backend ที่เป็นเจ้าของ PostgreSQL) ---
# แชทบอทไม่ต่อ PostgreSQL ตรง ๆ แต่เรียกผ่าน API ตัวนี้ (ดูเหตุผลใน app/config.py)
# ใน docker-compose ของ backend เปิดพอร์ต 3000 ไว้ ส่วน postgres map 5433:5432
# ซึ่งแชทบอทไม่ต้องใช้เลย
# รันด้วย uvicorn บนเครื่องตรง ๆ ใช้ localhost ได้
# แต่ถ้ารันแชทบอทใน Docker ให้เปลี่ยนเป็น http://host.docker.internal:3000/api
# เพราะ localhost ใน container หมายถึงตัว container เอง
BOOKING_API_BASE_URL=http://localhost:3000/api
BOOKING_API_TIMEOUT_SECONDS=10
# key ลับที่บอทแนบเป็น header X-Internal-Key เพื่อไม่ให้ NestJS นับ rate limit ให้บอท
# (เฉพาะ GET ไม่ได้ให้สิทธิ์อ่านข้อมูลเพิ่ม) ต้องตรงกับ CHATBOT_INTERNAL_KEY
# ใน tourist-booking-application/backend/.env — ห้าม commit ค่าจริง
# ปล่อยว่างก็ใช้ได้ แต่จะโดน 429 ง่ายเมื่อมีลูกค้าถามพร้อมกันหลายคน
BOOKING_API_INTERNAL_KEY=

# --- Tool calling ---
# จำนวนรอบสูงสุดที่ยอมให้โมเดลเรียก tool ก่อนบังคับให้สรุปคำตอบ
AGENT_MAX_TOOL_ROUNDS=3

# --- RAG settings ---
RETRIEVAL_TOP_K=5
LLM_TIMEOUT_SECONDS=30

# --- ประวัติบทสนทนา (SQLite ใน data/chat_history.db) ---
# CHAT_HISTORY_PATH — ไม่ต้องตั้ง ปล่อยให้โค้ดคำนวณเอง (เหตุผลเดียวกับ CHROMA_PATH)
# จำนวนข้อความล่าสุดที่ส่งให้ LLM (10 = ถาม-ตอบ 5 คู่) ยิ่งมากยิ่งเปลือง token
CHAT_HISTORY_MAX_MESSAGES=10
# ข้อความที่เก่ากว่านี้ (วัน) ถูกลบทิ้ง
CHAT_HISTORY_TTL_DAYS=7
