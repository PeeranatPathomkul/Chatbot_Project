# คัดลอกไฟล์นี้เป็น evaluate/.env แล้วกรอกค่าจริง (.env ถูก gitignore ไว้แล้ว)
# harness อ่านค่าจากไฟล์นี้หรือจาก environment variable และไม่เขียนค่าเหล่านี้ลง raw / log / report

# --- บัญชีลูกค้าทดสอบ (ใช้กับ get_my_bookings / get_booking_payment) ---
# ต้องมีการจองอย่างน้อย 1 รายการ ควรเป็นการจองที่ยังไม่ถึงวันเข้าพัก
# ถ้าเว้นว่าง harness จะข้ามการทดสอบที่ต้องล็อกอิน แล้วบอกไว้ในรายงาน
EVAL_CUSTOMER_EMAIL=
EVAL_CUSTOMER_PASSWORD=

# --- ลูกค้าอีกคน (ไม่บังคับ) ---
# ใช้ทดสอบว่าลูกค้า A ถามถึงเลขการจองของ B แล้วต้องไม่ได้ข้อมูล
# บัญชีนี้ต้องมีการจองอย่างน้อย 1 รายการ เพื่อให้มีเลขการจองไปลองถาม
EVAL_OTHER_EMAIL=
EVAL_OTHER_PASSWORD=

# --- Booking API (NestJS) ---
BOOKING_API_BASE_URL=http://localhost:3000/api
# ค่าเดียวกับ BOOKING_API_INTERNAL_KEY ใน resort-chatbot-api/.env
# ถ้าเว้นว่าง harness จะอ่านจาก resort-chatbot-api/.env ให้เอง
BOOKING_API_INTERNAL_KEY=

# --- Chatbot API ที่จะประเมิน ---
EVAL_API_BASE_URL=http://localhost:8000

# --- LLM judge: "typhoon" หรือ "gemini" ---
# key ที่เว้นว่างจะอ่านจาก resort-chatbot-api/.env ให้เอง
EVAL_JUDGE_PROVIDER=typhoon
EVAL_JUDGE_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_API_KEY=
GEMINI_API_KEY=

# --- ราคา token สำหรับประมาณต้นทุนต่อคำถาม (เว้นว่าง = รายงานแค่จำนวน token) ---
# ใส่ราคาต่อ 1 ล้าน token ตามหน้า pricing ของผู้ให้บริการ ณ วันที่ทดสอบ
EVAL_PRICE_INPUT_PER_1M=
EVAL_PRICE_OUTPUT_PER_1M=
EVAL_PRICE_CURRENCY=USD

# --- จังหวะการยิงคำขอ (กัน rate limit) ---
EVAL_DELAY_SECONDS=2
EVAL_MAX_RETRIES=5
EVAL_TIMEOUT_SECONDS=90
